---
const { title = 'ODServa2030', description = 'Observatorio de implementación de la Agenda 2030' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style is:global>
      :root {
        /* ── MARCA ── */
        --brand:              #6EC1E4;
        --brand-hover:        #4faed4;
        --brand-soft:         #e8f7fc;

        /* Alias conservados para los estilos existentes */
        --green-deep:         var(--brand);
        --green-mid:          var(--brand-hover);
        --green-accent:       var(--brand);
        --green-light:        #b7e4f5;
        --green-pale:         var(--brand-soft);

        --gold:               var(--brand);
        --gold-light:         #d8eff8;

        /* ── FONDOS ── */
        --cream:              #ffffff;   /* Fondo principal */
        --paper:              #f3f4f7;   /* Fondo secundario / bloques */

        /* ── TEXTO ── */
        --ink:                #000000;   /* Texto de máximo énfasis */
        --ink-mid:            #000000;   /* Texto de cuerpo estándar */
        --ink-soft:           #000000;   /* Texto secundario y metadatos */

        /* ── BORDES ── */
        --border:             #dbe3e8;   /* Separadores y bordes de componentes */

        /* ── LAYOUT ── */
        --sidebar-w:          270px;
        --font-base:          'Roboto Slab', serif;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background: var(--cream);
        color: var(--ink);
        font-family: var(--font-base);
        font-weight: 400;
        display: flex;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: var(--green-accent);
        text-decoration: none;
        transition: color 0.2s ease;
      }

      a:hover {
        color: var(--green-mid);
      }

      h2 {
        color: var(--brand);
        font-family: var(--font-base);
      }

      h1 {
        color: var(--ink);
        font-family: var(--font-base);
      }

      strong,
      b {
        color: var(--brand);
        font-weight: 700;
      }

      button {
        font-family: var(--font-base);
      }

      /* Estilo para el contenedor principal que envuelve sidebar y contenido */
      .app-layout {
        display: flex;
        width: 100%;
        min-height: 100vh;
      }

      main {
        flex: 1;
        min-width: 0;
        max-width: 860px;
        padding: 3rem 4rem;
        margin-right: auto;
      }

      /* Animación de carga */
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .section {
        animation: fadeUp 0.5s ease forwards;
      }

      /* Focus visible para accesibilidad */
      :focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body>
    <div class="app-layout">
      <slot />
    </div>
  </body>
</html>
