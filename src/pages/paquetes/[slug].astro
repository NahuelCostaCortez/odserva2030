---
import Layout from '../../components/Layout.astro';
import SectionContent from '../../components/SectionContent.astro';
import O1Dashboard from '../../components/dashboards/O1Dashboard.astro';
import O2Dashboard from '../../components/dashboards/O2Dashboard.astro';
import O4Dashboard from '../../components/dashboards/O4Dashboard.astro';
import O5Dashboard from '../../components/dashboards/O5Dashboard.astro';
import O9Dashboard from '../../components/dashboards/O9Dashboard.astro';
import O10Dashboard from '../../components/dashboards/O10Dashboard.astro';
import O11Dashboard from '../../components/dashboards/O11Dashboard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work-packages');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { pkg: entry }
  }));
}

const { pkg } = Astro.props;
const dataPath = pkg.data.dataPath;
const slug = pkg.data.slug;

const contentSections = pkg.data.sectionsIndex.filter(
  (section, index) =>
    index !== 0 && section.title.toLowerCase() !== 'índice'
);

const dashboardNavs: Record<string, { slug: string; title: string; level: number }[]> = {
  o4: [
    { slug: 'o4-hero',        title: 'Introducción',        level: 1 },
    { slug: 'o4-marco',       title: 'Marco teórico',       level: 1 },
    { slug: 'o4-crisis',      title: 'Crisis global',       level: 1 },
    { slug: 'o4-agenda',      title: 'Agenda 2030',         level: 1 },
    { slug: 'o4-propuesta',   title: 'Propuesta formativa', level: 1 },
    { slug: 'o4-evaluacion',  title: 'Evaluación',          level: 1 },
    { slug: 'o4-programa',    title: 'Programa 9 ECTS',     level: 1 },
    { slug: 'o4-implantacion',title: 'Implantación',        level: 1 },
  ],
  o2: [
    { slug: 'o2-hero',        title: 'Introducción',           level: 1 },
    { slug: 'o2-normativa',   title: 'Propuestas: Normativa',  level: 1 },
    { slug: 'o2-gobierno',    title: 'Propuestas: Gobierno',   level: 1 },
    { slug: 'o2-practicas',   title: 'Buenas prácticas',       level: 1 },
    { slug: 'o2-conclusiones',title: 'Conclusiones',           level: 1 },
  ],
  o5: [
    { slug: 'o5-hero',        title: 'Resumen',                level: 1 },
    { slug: 'o5-metodologia', title: 'Metodología',            level: 1 },
    { slug: 'o5-nacional',    title: 'Convocatorias nacionales', level: 1 },
    { slug: 'o5-europeo',     title: 'Convocatorias europeas', level: 1 },
    { slug: 'o5-tabla-eur',   title: 'Inventario europeo',     level: 2 },
    { slug: 'o5-conclusiones',title: 'Conclusiones',           level: 1 },
  ],
  o9: [
    { slug: 'o9-hero',        title: 'Resumen',                level: 1 },
    { slug: 'o9-contexto',    title: 'Contexto y metodología', level: 1 },
    { slug: 'o9-resultados',  title: 'Resultados',             level: 1 },
    { slug: 'o9-practicas',   title: 'Buenas prácticas',       level: 1 },
    { slug: 'o9-propuestas',  title: 'Propuestas de futuro',   level: 1 },
    { slug: 'o9-conclusiones',title: 'Conclusiones',           level: 1 },
  ],
  o10: [
    { slug: 'o10-hero',          title: 'Resumen',              level: 1 },
    { slug: 'o10-metodologia',   title: 'Metodología',          level: 1 },
    { slug: 'o10-universidades', title: 'Distribución geográf.', level: 1 },
    { slug: 'o10-memorias',      title: 'Memorias',             level: 1 },
    { slug: 'o10-compromiso',    title: 'Compromiso A2030',     level: 1 },
    { slug: 'o10-ods',           title: 'Mención de ODS',       level: 1 },
    { slug: 'o10-otros',         title: 'Otros documentos',     level: 1 },
    { slug: 'o10-conclusion',    title: 'Conclusión',           level: 1 },
  ],
  o11: [
    { slug: 'o11-hero',          title: 'Resumen',              level: 1 },
    { slug: 'o11-publicacion',   title: 'Info en web',          level: 1 },
    { slug: 'o11-idiomas',       title: 'Idiomas',              level: 1 },
    { slug: 'o11-accesibilidad', title: 'Accesibilidad',        level: 1 },
    { slug: 'o11-conclusion',    title: 'Conclusión',           level: 1 },
  ],
  o1: [
    { slug: 'o1-hero',          title: 'Resumen',                  level: 1 },
    { slug: 'o1-losu',          title: 'La LOSU y los ODS',        level: 1 },
    { slug: 'o1-hub',           title: 'Universidades y ODS',      level: 1 },
    { slug: 'o1-cobertura',     title: 'Cobertura en estatutos',   level: 2 },
    { slug: 'o1-targets',       title: 'Metas y targets',          level: 2 },
    { slug: 'o1-extremos',      title: 'Ranking extremos',         level: 2 },
    { slug: 'o1-genero',        title: 'Gobernanza: Genero',       level: 1 },
    { slug: 'o1-tamano',        title: 'Tamaño organos gobierno',  level: 2 },
    { slug: 'o1-sostenibilidad',title: 'Sostenibilidad institucional', level: 1 },
    { slug: 'o1-conclusiones',  title: 'Conclusiones',             level: 1 },
  ],
};

const isDashboard = slug in dashboardNavs;
const navSections = isDashboard ? dashboardNavs[slug] : null;
---
<Layout title={`ODServa2030 · ${pkg.data.title}`}>
  <aside class="sidebar">
    <div class="sidebar-header">
      <div class="sidebar-badge">{pkg.data.code} · Informe</div>
      <div class="sidebar-title">{pkg.data.title}</div>
      <div class="sidebar-meta">
        {isDashboard ? (
          <span>Dashboard interactivo</span>
        ) : (
          <>
            <span>{contentSections.length} secciones</span>
            <span>{pkg.data.counts.tables} tablas</span>
            <span>{pkg.data.counts.figures} figuras</span>
          </>
        )}
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-label">Indice</div>
      {isDashboard ? (
        navSections!.map((section) => (
          <a href={`#${section.slug}`} class={`nav-item level-${section.level}`}>
            {section.title}
          </a>
        ))
      ) : (
        contentSections.map((section) => (
          <a
            href={`#${section.slug}`}
            class={`nav-item level-${Math.min(section.level, 3)}`}
          >
            {section.title}
          </a>
        ))
      )}
      <div class="nav-divider"></div>
      <a href="/" class="nav-item back-nav">&larr; Volver al inicio</a>
    </nav>
  </aside>

  <main class="main-content">
    {slug === 'o11' ? (
      <O11Dashboard pkg={pkg} />
    ) : slug === 'o10' ? (
      <O10Dashboard pkg={pkg} />
    ) : slug === 'o5' ? (
      <O5Dashboard pkg={pkg} />
    ) : slug === 'o1' ? (
      <O1Dashboard pkg={pkg} />
    ) : slug === 'o2' ? (
      <O2Dashboard pkg={pkg} />
    ) : slug === 'o4' ? (
      <O4Dashboard pkg={pkg} />
    ) : slug === 'o9' ? (
      <O9Dashboard pkg={pkg} />
    ) : (
      <>
        <div class="doc-header">
          <div class="doc-kicker">Normativa Universitaria Espanola · 2024</div>
          <h1 class="doc-title">{pkg.data.title}</h1>
        </div>
        <div id="package-sections" data-package-path={dataPath}>
          {contentSections.map((section) => (
            <SectionContent section={section} />
          ))}
        </div>
      </>
    )}
  </main>

  <script>
    import '../../scripts/package-viewer.ts';
  </script>
</Layout>

<style>
  /* SIDEBAR */
  .sidebar {
    width: var(--sidebar-w);
    background: #ffffff;
    color: var(--ink);
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    flex-shrink: 0;
    z-index: 100;
    border-right: 1px solid var(--border);
  }

  .sidebar-header {
    padding: 2rem 1.5rem 1.5rem;
    border-bottom: 1px solid var(--border);
    background: var(--paper);
  }

  .sidebar-badge {
    display: inline-flex;
    background: var(--brand);
    color: #ffffff;
    font-family: var(--font-base);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 2px;
    margin-bottom: 0.8rem;
  }

  .sidebar-title {
    font-family: var(--font-base);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--brand);
    margin-bottom: 0.8rem;
  }

  .sidebar-meta {
    font-family: var(--font-base);
    font-size: 0.82rem;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .sidebar-meta span::before {
    content: '— ';
    color: var(--brand);
  }

  /* SIDEBAR NAV */
  .sidebar-nav { padding-bottom: 2rem; }

  .nav-section-label {
    font-family: var(--font-base);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand);
    padding: 1.2rem 1.5rem 0.4rem;
  }

  .nav-item {
    display: block;
    font-family: var(--font-base);
    padding: 0.6rem 1.5rem;
    transition: all 0.15s;
    border-left: 2px solid transparent;
    line-height: 1.4;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-item.level-1 {
    font-weight: 500;
    color: var(--ink);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .nav-item.level-2 {
    padding-left: 2.2rem;
    font-size: 0.88rem;
    color: var(--ink);
  }

  .nav-item.level-3 {
    padding-left: 3rem;
    font-size: 0.73rem;
    color: var(--ink);
  }

  .nav-item:hover {
    color: var(--brand);
    background: var(--brand-soft);
    border-left: 2px solid var(--brand);
  }

  .nav-item.back-nav {
    margin-top: 0.5rem;
    color: var(--brand);
    opacity: 1;
    font-size: 0.95rem;
  }

  .nav-item.back-nav:hover {
    opacity: 1;
    background: transparent;
    border-left-color: transparent;
    text-decoration: underline;
  }

  .nav-divider {
    height: 1px;
    background: var(--border);
    margin: 0.8rem 1.5rem;
  }

  .sidebar::-webkit-scrollbar { width: 4px; }
  .sidebar::-webkit-scrollbar-thumb {
    background: var(--brand);
    border-radius: 2px;
  }

  /* STANDARD DOC HEADER */
  .doc-header {
    padding-bottom: 2.5rem;
    margin-bottom: 3.5rem;
    border-bottom: 2px solid var(--green-deep);
    position: relative;
  }

  .doc-header::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 80px;
    height: 2px;
    background: var(--gold);
  }

  .doc-kicker {
    font-family: var(--font-base);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green-accent);
    margin-bottom: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .doc-kicker::before {
    content: '';
    display: block;
    width: 20px;
    height: 1px;
    background: var(--green-accent);
  }

  .doc-title {
    font-family: var(--font-base);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    max-width: 650px;
    margin: 0;
  }

  @media (max-width: 800px) {
    .sidebar { display: none; }
  }
</style>
